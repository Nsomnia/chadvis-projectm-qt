# ---------------------------------------------------------------------------
# ChadVis clang-tidy configuration.  clang-tidy 23.1.2 (Homebrew LLVM).
#
# HOW TO INVOKE
#
#   clang-tidy is NOT on PATH by default. It lives in the Homebrew LLVM keg:
#       export PATH="/usr/local/opt/llvm/bin:$PATH"
#
#   build/compile_commands.json is generated by the Ninja configure, so the
#   build directory must exist first. Then, for ONE file:
#
#       SDK="$(xcrun --show-sdk-path)"
#       clang-tidy -p build \
#         --extra-arg-before=-isystem --extra-arg-before=/usr/local/opt/llvm/include/c++/v1 \
#         --extra-arg-before=-isystem --extra-arg-before="$SDK/usr/include" \
#         --extra-arg-before=-isystem --extra-arg-before="$(brew --prefix spdlog)/include" \
#         --extra-arg-before=-isystem --extra-arg-before="$(brew --prefix fmt)/include" \
#         --extra-arg-before=-isystem --extra-arg-before="$(brew --prefix taglib)/include" \
#         --extra-arg-before=-isystem --extra-arg-before="$(brew --prefix tomlplusplus)/include" \
#         --extra-arg-before=-idirafter --extra-arg-before=/usr/local/include \
#         src/core/Logger.cpp
#
#   Whole tree (slow; run it on purpose, not on every save):
#       run-clang-tidy -p build '^src/.*\.cpp$'
#   Apply fixes to one file (READ THE DIFF):
#       clang-tidy -p build --fix-errors ... src/core/Logger.cpp
#
# WHY THOSE EXTRA ARGS ARE MANDATORY (this is why .clang-tidy had never run)
#   build/compile_commands.json records the command for Apple clang 16
#   (/usr/bin/c++), and it carries no -isysroot and no libc++ path. Apple clang
#   infers the macOS SDK anyway; Homebrew LLVM's clang-tidy does not, so with
#   only `-p build` it cannot find the C++ standard library headers and dies:
#
#     $ clang-tidy -p build src/core/Logger.cpp
#     .../spdlog/details/null_mutex.h:6:10: error: 'atomic' file not found
#
#   Measured 2026-09-29: that is the ONLY error, and adding -isystem for libc++
#   and the SDK (plus spdlog) takes it to zero. Note what the error location
#   proves: /usr/local/include WAS resolved — clang-tidy read the spdlog header
#   from there and only then failed to find <atomic> inside it. So libc++ and
#   the SDK are what are missing, not Homebrew's include root. An earlier
#   revision of this comment claimed all three were unresolvable; that was
#   wrong, and the fix was found by reading the error's file path.
#
#   Adding -isystem for the SDK fixes libc++ too, because the SDK's
#   usr/include/c++/v1 is where it lives.
#
#   The real fix belongs in cmake/ (export CMAKE_EXPORT_COMPILE_COMMANDS with an
#   -isysroot, or add the include dirs to the target's INTERFACE_INCLUDE_DIRECTORIES),
#   which would make the flags above unnecessary. Until then they are load-bearing.
#   That is out of scope for a config file, so the incantation lives here.
#
# PREVIOUS REVISION WAS AN LLVM COPY-PASTE AND WRONG ON EVERY NAMING KEY
#   It asked for CamelCase parameters, variables and members with no trailing
#   underscore. Measured against src/, the real convention is below, so the old
#   rules flagged correct code. The measured false-positive rate of the new
#   rules is about 2 findings per 400-line file (the 14 constants out of 95
#   that use kPascalCase or camelBack instead of UPPER_CASE).
#
# NOISE BUDGET (measured by running this exact config, see HOW TO INVOKE)
#     src/core/Logger.cpp             0 findings
#     src/suno/ClipParser.cpp         0 findings
#     src/visualizer/PresetScanner    6 findings
#     src/util/FileUtils.cpp         17 findings, 2 of them naming
#   The dominant check is readability-braces-around-statements, which asks for
#   braces on single-statement if bodies. That is a real, cheap, actionable
#   style finding, not noise, so it stays enabled.
#   Anything noisier than the above is disabled below, with the reason inline.
# ---------------------------------------------------------------------------

Checks: >
  -*,
  clang-diagnostic-*,
  clang-analyzer-*,
  bugprone-*,
  concurrency-*,
  performance-*,
  portability-*,
  readability-*,
  modernize-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-exception-escape,
  -bugprone-narrowing-conversions,
  -bugprone-suspicious-stringview-data-usage,
  -concurrency-mt-unsafe,
  -misc-const-correctness,
  -misc-include-cleaner,
  -misc-no-recursion,
  -misc-non-private-member-variables-in-classes,
  -misc-unused-parameters,
  -misc-use-anonymous-namespace,
  -modernize-avoid-bind,
  -modernize-loop-convert,
  -modernize-return-braced-init-list,
  -modernize-use-ranges,
  -modernize-use-trailing-return-type,
  -performance-avoid-endl,
  -readability-avoid-const-params-in-decls,
  -readability-function-cognitive-complexity,
  -readability-identifier-length,
  -readability-implicit-bool-conversion,
  -readability-magic-numbers,
  -readability-qualified-auto,

# Reasons for the disables above, so nobody re-enables them blind:
#   bugprone-easily-swappable-parameters  flags Qt signal slots and every
#       setters-then-getters bridge signature; the whole qml_bridge/ layer is
#       built that way on purpose.
#   bugprone-exception-escape            Qt signal emission crosses throw
#       boundaries by design; every QObject method trips it.
#   bugprone-narrowing-conversions      the audio path does u64 -> f32 and
#       i64 -> u32 sample arithmetic on purpose; every PFFFT/AV call trips it.
#   concurrency-mt-unsafe               EXPENSIVE and currently wrong: TODO.md
#       records that Playlist is single-threaded by contract and that
#       LyricsSync was found with two independent position writers. A check
#       that reports those as bugs while they are deliberate buys nothing.
#   misc-const-correctness              Qt's own non-const accessors and
#       moc-generated members are unfixable; near-total noise.
#   modernize-avoid-bind                std::bind is already absent.
#   modernize-loop-convert / use-ranges C++23 ranges are not adopted yet, and
#       the projectM bridge is FFI'd to vendor sources; rewriting loops now
#       would fight both.
#   modernize-return-braced-init-list   readability-marginal here and it fights
#       the explicit `return {}` / `return Result<T>::err(...)` style.
#   modernize-use-trailing-return-type  the tree uses LEADING return types
#       everywhere (`auto f() -> T`); enabling this would rewrite every
#       declaration in src/. Non-negotiable style, not a preference.
#   performance-avoid-endl              the CLI help banner is built with
#       std::endl-free ostream chains on purpose.
#   readability-identifier-length       the codebase is dense and correct:
#       x, y, id, fs, pm, u8, f32, kd. Length is the least useful signal here.
#   readability-implicit-bool-conversion Qt's own APIs return enums used as
#       bools; the noise is not ours to fix.
#   readability-magic-numbers           measured 12 findings in FileUtils.cpp
#       alone, all of them time-unit arithmetic (3600000 ms, 60000, 1024.0) and
#       char-range masks (0x1F, 0x7F). Every codebase has these; they are not
#       defects.
#   readability-qualified-auto          the tree says `const auto&` consistently
#       already, so the check has nothing to say and fights the local style
#       where it does.

WarningsAsErrors: ''

# Only surface findings in code we own, not in Qt / FFmpeg / libspdlog headers.
HeaderFilterRegex: '^(src|tests)/'

FormatStyle: none

CheckOptions:
  # --- naming: measured from src/, not assumed ---------------------------------
  #   class / struct / union / enum       CamelCase
  #   enum constants                      CamelCase
  #   functions / methods                 camelBack
  #   parameters                          camelBack
  #   locals, globals, static variables   camelBack
  #   private/protected class members     camelBack + trailing underscore
  #   public/struct data members          camelBack, NO underscore
  #   namespaces                          lower_case
  #   namespace-scope constants           UPPER_CASE
  #   typedefs / using aliases            CamelCase
  - key:             readability-identifier-naming.ClassCase
    value:           CamelCase
  - key:             readability-identifier-naming.ClassMemberCase
    value:           camelBack
  - key:             readability-identifier-naming.ClassMemberSuffix
    value:           '_'
  - key:             readability-identifier-naming.ConstantCase
    value:           UPPER_CASE
  - key:             readability-identifier-naming.ConstantMemberCase
    value:           camelBack
  - key:             readability-identifier-naming.EnumCase
    value:           CamelCase
  - key:             readability-identifier-naming.EnumConstantCase
    value:           CamelCase
  - key:             readability-identifier-naming.FunctionCase
    value:           camelBack
  - key:             readability-identifier-naming.GlobalConstantCase
    value:           UPPER_CASE
  - key:             readability-identifier-naming.GlobalVariableCase
    value:           camelBack
  - key:             readability-identifier-naming.LocalConstantCase
    value:           camelBack
  - key:             readability-identifier-naming.LocalVariableCase
    value:           camelBack
  - key:             readability-identifier-naming.MemberCase
    value:           camelBack
  - key:             readability-identifier-naming.MethodCase
    value:           camelBack
  - key:             readability-identifier-naming.NamespaceCase
    value:           lower_case
  - key:             readability-identifier-naming.ParameterCase
    value:           camelBack
  - key:             readability-identifier-naming.PrivateMemberCase
    value:           camelBack
  - key:             readability-identifier-naming.PrivateMemberSuffix
    value:           '_'
  - key:             readability-identifier-naming.ProtectedMemberCase
    value:           camelBack
  - key:             readability-identifier-naming.ProtectedMemberSuffix
    value:           '_'
  # Struct/union data members are plain names (Vec2::x, Size::width), so they
  # get their own case rule rather than inheriting the private-member suffix.
  - key:             readability-identifier-naming.PublicMemberCase
    value:           camelBack
  - key:             readability-identifier-naming.StructCase
    value:           CamelCase
  - key:             readability-identifier-naming.StaticConstantCase
    value:           UPPER_CASE
  - key:             readability-identifier-naming.StaticVariableCase
    value:           camelBack
  - key:             readability-identifier-naming.StaticVariableSuffix
    value:           '_'
  - key:             readability-identifier-naming.TemplateParameterCase
    value:           CamelCase
  - key:             readability-identifier-naming.TypedefCase
    value:           CamelCase
  - key:             readability-identifier-naming.TypeTemplateParameterCase
    value:           CamelCase
  - key:             readability-identifier-naming.UnionCase
    value:           CamelCase
  - key:             readability-identifier-naming.UsingCase
    value:           CamelCase
  # Qt's moc owns these names, and the X-macro table in SettingMacros.hpp owns
  # the CLI flag identifiers. Neither is ours to rename.
  - key:             readability-identifier-naming.FunctionIgnoredRegexp
    value:           '^(main|Q_OBJECT|Q_PROPERTY|Q_INVOKABLE|Q_ENUM|Q_SIGNAL|Q_SLOT|Q_SLOTS|qt_metacall|qt_metacast|qmlRegister|TRY)$'
  - key:             readability-identifier-naming.ClassIgnoredRegexp
    value:           '^(Q_OBJECT|QML_ELEMENT|QML_SINGLETON|QML_NAMED_ELEMENT)$'

  # --- size limits, sized to AGENTS.md's ~500 LOC soft ceiling ---------------
  - key:             readability-function-size.LineThreshold
    value:           '200'
  - key:             readability-function-size.StatementThreshold
    value:           '80'
  - key:             readability-function-size.ParameterThreshold
    value:           '10'
  - key:             readability-function-size.NestingThreshold
    value:           '8'
  - key:             readability-function-size.BranchThreshold
    value:           '15'

  # --- thresholds shaped by this codebase ------------------------------------
  - key:             readability-braces-around-statements.AllowShortLambdasOnASingleLine
    value:           'true'
  - key:             readability-braces-around-statements.ShortStatementLines
    value:           '1'
  - key:             bugprone-assert-side-effect.AssertMacros
    value:           'assert,Q_ASSERT,Q_ASSERT_X,QVERIFY,QCOMPARE,Q_REQUIRE'
  - key:             modernize-use-nullptr.NullMacros
    value:           'NULL'
  - key:             modernize-use-emplace.ContainerTemporaryLifetime
    value:           '0'
  - key:             modernize-use-designated-initializers.IgnoreSingleElementAggregates
    value:           '1'

  # --- already true in src/, so the generic check has nothing left to say ----
  - key:             readability-redundant-member-init.IgnoreBaseInCopyConstructors
    value:           '1'
  - key:             modernize-use-default-member-init.UseAssignment
    value:           '1'
  - key:             readability-identifier-naming.IgnoreMainLikeFunctions
    value:           '1'
