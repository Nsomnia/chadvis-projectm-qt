<!-- Script 1: GCLID + UTM Saver -->
<script type="text/javascript">
(function() {
  // Function to get a URL parameter
  function getQueryParam(param) {
    var query = window.location.search.substring(1);
    var vars = query.split('&');
    for (var i = 0; i < vars.length; i++) {
      var pair = vars[i].split('=');
      if (decodeURIComponent(pair[0]) === param) {
        return decodeURIComponent(pair[1]);
      }
    }
    return null;
  }
  
  // Parameters we want to store
	const utmParams = [
    'utm_source',
    'utm_medium',
    'utm_campaign',
    'utm_term',
    'utm_content',
  ];

  // Get gclid from URL
  var gclid = getQueryParam('gclid');

  // If gclid exists, save it in session storage
  if (gclid) {
    sessionStorage.setItem('gclid', gclid);
  }
  
  // Save any UTM params if present
  var newUtmData = {};
  utmParams.forEach(function(param) {
    var value = getQueryParam(param);
    if (value) {
      newUtmData[param] = value.trim();
    }
  });
  
  if (Object.keys(newUtmData).length === 0) {
  	return;
  };
  
  var existing = {};
  try {
  	existing = JSON.parse(sessionStorage.getItem('utmData') || '{}');
  } catch (e) {
  	existing = {};
  }
  
  for (var key in newUtmData) {
  	if (Object.prototype.hasOwnProperty.call(newUtmData, key)) {
    	existing[key] = newUtmData[key];
    }
  }
  
  sessionStorage.setItem('utmData', JSON.stringify(existing));
})();
</script>

